{
  "todo{}": {
    "prefix": "todo",
    "body": [
      "\\todo{${1:text%todo}}"
    ],
    "luasnip": {
      "priority": 6000
    }
  },
  "todo[]{}": {
    "prefix": "todo",
    "body": [
      "\\todo[${2:options%keyvals}]{${1:text%todo}}"
    ],
    "luasnip": {
      "priority": 4000
    }
  },
  "todoarea{}{}": {
    "prefix": "todoarea",
    "body": [
      "\\todoarea{${1:note text%todo}}{${2:highlighted text}}"
    ],
    "luasnip": {
      "priority": 6000
    }
  },
  "todoarea[]{}{}": {
    "prefix": "todoarea",
    "body": [
      "\\todoarea[${3:options%keyvals}]{${1:note text%todo}}{${2:highlighted text}}"
    ],
    "luasnip": {
      "priority": 4000
    }
  },
  "missingfigure{}": {
    "prefix": "missingfigure",
    "body": [
      "\\missingfigure{${1:text%todo}}"
    ],
    "luasnip": {
      "priority": 6000
    }
  },
  "missingfigure[]{}": {
    "prefix": "missingfigure",
    "body": [
      "\\missingfigure[${2:options%keyvals}]{${1:text%todo}}"
    ],
    "luasnip": {
      "priority": 4000
    }
  },
  "listoftodos": {
    "prefix": "listoftodos",
    "body": [
      "\\listoftodos"
    ],
    "luasnip": {
      "priority": 6000
    }
  },
  "listoftodos[]": {
    "prefix": "listoftodos",
    "body": [
      "\\listoftodos[${1:name}]"
    ],
    "luasnip": {
      "priority": 4000
    }
  },
  "todototoc": {
    "prefix": "todototoc",
    "body": [
      "\\todototoc"
    ],
    "luasnip": {
      "priority": 6000
    }
  }
}
